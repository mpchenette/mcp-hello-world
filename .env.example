# Copy this file to .env and fill in the secrets from your GitHub OAuth app.
SERVER_NAME=FastMCP OAuth Demo
SERVER_BASE_URL=http://localhost:8000
MCP_HOST=127.0.0.1
MCP_PORT=8000

# GitHub OAuth app credentials
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# Optional: scopes to request during authorization (comma separated)
# GITHUB_SCOPES=read:user

# Optional: restrict which redirect URIs clients may use (comma separated, supports wildcards)
# ALLOWED_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*
