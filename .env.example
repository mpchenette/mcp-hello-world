# Environment configuration for the barebones FastMCP server secured with GitHub OAuth
MCP_SERVER_NAME=Barebones FastMCP Server
MCP_PORT=8000

# GitHub OAuth credentials (replace with values from your GitHub OAuth app)
FASTMCP_SERVER_AUTH_GITHUB_CLIENT_ID=replace-with-your-client-id
FASTMCP_SERVER_AUTH_GITHUB_CLIENT_SECRET=replace-with-your-client-secret

# Public base URL for your FastMCP server. Use http://localhost:8000 for local testing.
FASTMCP_SERVER_AUTH_GITHUB_BASE_URL=http://localhost:8000

# Optional overrides (uncomment and adjust as needed)
# FASTMCP_SERVER_AUTH_GITHUB_REDIRECT_PATH=/auth/callback
# FASTMCP_SERVER_AUTH_GITHUB_REQUIRED_SCOPES=user
# FASTMCP_SERVER_AUTH_GITHUB_ALLOWED_CLIENT_REDIRECT_URIS=http://localhost:*,http://127.0.0.1:*
